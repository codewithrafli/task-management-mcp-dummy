# /etc/systemd/system/task-management-scheduler.service
# (Opsional) Menjalankan Laravel scheduler. Aktifkan dengan:
#   sudo systemctl enable --now task-management-scheduler.timer
# Butuh file .timer pendamping (lihat DEPLOYMENT.md).

[Unit]
Description=Task Management Laravel Scheduler
After=network.target

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/var/www/task-management
ExecStart=/usr/bin/php artisan schedule:run
