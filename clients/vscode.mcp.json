{
  "//": "VS Code (Copilot Agent / MCP) — salin ke .vscode/mcp.json. Perhatikan: key 'servers', bukan 'mcpServers'.",
  "inputs": [
    {
      "type": "promptString",
      "id": "mcp-token",
      "description": "Personal access token (php artisan mcp:token you@example.com)",
      "password": true
    }
  ],
  "servers": {
    "task-management-stdio": {
      "type": "stdio",
      "command": "php",
      "args": [
        "/absolute/path/to/mcp-dummy/artisan",
        "mcp:start",
        "task-management"
      ]
    },
    "task-management-http": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp/task-management",
      "headers": {
        "Authorization": "Bearer ${input:mcp-token}"
      }
    }
  }
}
