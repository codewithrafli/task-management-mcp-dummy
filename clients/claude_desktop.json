{
  "//": "Claude Desktop — salin ke config (macOS: ~/Library/Application Support/Claude/claude_desktop_config.json).",
  "//stdio": "Rekomendasi lokal: stdio langsung (tanpa server nyala).",
  "//http": "Untuk URL/OAuth gunakan varian 'task-management-remote' via mcp-remote (server harus nyala).",
  "mcpServers": {
    "task-management": {
      "command": "php",
      "args": [
        "/absolute/path/to/mcp-dummy/artisan",
        "mcp:start",
        "task-management"
      ]
    },
    "task-management-remote": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "http://127.0.0.1:8000/mcp/task-management"
      ]
    }
  }
}
